{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "idealhub-content seo.json",
  "description": "Standard shape of every seo.json in this repo. Two variants exist: (1) page seo.json — title/description plus an optional keyed structuredData map; (2) renovation/{locale}/seo.json — one entry per route (renovation, quote, gallery, faq). structuredData entries are keyed schema.org objects; each key renders as its own <JsonLd> script via the shared StructuredData component in rental-web. Validate all files with: npx ajv-cli validate -s schemas/seo.schema.json -d '**/seo.json' --spec=draft7",
  "oneOf": [
    { "$ref": "#/definitions/pageSeo" },
    { "$ref": "#/definitions/renovationSeo" }
  ],
  "definitions": {
    "pageSeo": {
      "$ref": "#/definitions/seo"
    },
    "renovationSeo": {
      "type": "object",
      "required": ["renovation", "quote", "gallery", "faq"],
      "additionalProperties": false,
      "properties": {
        "renovation": { "$ref": "#/definitions/seo" },
        "quote": { "$ref": "#/definitions/seo" },
        "gallery": { "$ref": "#/definitions/seo" },
        "faq": { "$ref": "#/definitions/seo" }
      }
    },
    "seo": {
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string" },
        "published": { "type": "boolean" },
        "structuredData": { "$ref": "#/definitions/structuredData" }
      }
    },
    "structuredData": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/schemaOrgObject" }
    },
    "schemaOrgObject": {
      "type": "object",
      "required": ["@context", "@type"],
      "properties": {
        "@context": { "type": "string", "minLength": 1 },
        "@type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
